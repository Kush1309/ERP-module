PORT=5000
MONGODB_URI=mongodb://localhost:27017/school-erp
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# JWT (required) — use a long random secret in real deployments
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Initial admin seed only (npm run seed:admin) — never commit real passwords
ADMIN_PASSWORD=AdminPass123
